# Copie este arquivo para ".env" e ajuste se precisar:  cp .env.example .env
#
# Conexão com o banco PostgreSQL.
# O valor abaixo já funciona com o docker-compose.yml incluído no projeto.
# Em produção, troque pela URL do seu banco (ex: Neon, Supabase, etc.).
DATABASE_URL="postgresql://snipvault:snipvault@localhost:5432/snipvault?schema=public"
